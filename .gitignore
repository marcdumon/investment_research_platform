# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Secrets
.env

# Data — keep dirs, ignore contents
data/simfin/*
data/stooq/download/*
data/stooq/daily/*
!data/**/.gitkeep

# Allow project Claude settings despite global gitignore
!.claude/
!.claude/settings.json
